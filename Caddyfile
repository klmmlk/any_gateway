# 内置 HTTPS 反向代理（本文件烘在 gateway 镜像内，由 docker-entrypoint.sh 在
# 容器配置了 ACME_DOMAIN 与 CLOUDFLARE_API_TOKEN 环境变量时启动）。
#
# 证书验证方式为 DNS-01（通过 Cloudflare API 加/删 _acme-challenge TXT 记录），
# 不依赖任何入站端口，80/443 被运营商封锁也不影响签发与续期。
# 证书数据存 /app/data/caddy（宿主机 ./data/caddy），重建容器不重签。

https://{$ACME_DOMAIN}:8443 {
	reverse_proxy 127.0.0.1:8003 {
		# LLM 流式响应（SSE）逐块透传，不做缓冲
		flush_interval -1
	}

	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}
