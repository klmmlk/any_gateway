# 反向代理 + ACME 自动证书（DNS-01 验证）
#
# 用法：在 .env 中配置 ACME_DOMAIN（如 gw.example.com）和 CLOUDFLARE_API_TOKEN
# 后 `docker compose up -d caddy`。证书向 Let's Encrypt/ZeroSSL 自动申请，
# 到期前自动续期，证书数据持久化在 ./data/caddy。
#
# 验证方式为 DNS-01（Cloudflare API 加/删 TXT 记录），不需要任何入站端口，
# 因此 80/443 被运营商封锁也不影响签发与续期。
# HTTPS 监听 8443（Cloudflare 代理兼容端口，将来切橙云无需改动）。

https://{$ACME_DOMAIN}:8443 {
	reverse_proxy gateway:8003 {
		# LLM 流式响应（SSE）逐块透传，不做缓冲
		flush_interval -1
	}

	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
